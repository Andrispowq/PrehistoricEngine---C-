#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform samplerCube environmentMap;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2DArray outputMap;

layout(push_constant) uniform Parameters
{
    int mode;
    int resolution;
    float roughness;
    int samples;
} parameters;

#include "sampling.glsl"

#include "../../shared/environmentMap/cubeDirection.glsl"

#include "../../shared/environmentMap/brdf.glsl"

void main()
{
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(pixel.xy, ivec2(parameters.resolution)))) return;
    uint count = uint(parameters.samples);

    if (parameters.mode == 2)
    {
        vec2 uv = vec2(pixel.xy) / float(parameters.resolution);
        imageStore(outputMap, pixel, vec4(IntegrateBRDF(uv.x, uv.y, count), 0.0, 1.0));
        return;
    }

    vec3 N = CubeDirection(pixel, parameters.resolution);
    vec3 colour = ConvolveEnvironment(N, parameters.roughness, count, parameters.mode == 0);
    imageStore(outputMap, pixel, vec4(colour, 1.0));
}
