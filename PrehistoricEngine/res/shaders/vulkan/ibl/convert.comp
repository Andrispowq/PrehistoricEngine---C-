#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D panorama;
layout(binding = 1, rgba32f) uniform writeonly image2DArray outputMap;
#include "../../opengl/environmentMap/shared/cubeDirection.glsl"

void main()
{
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(outputMap);
    if (any(greaterThanEqual(pixel, size))) return;
    vec3 direction = CubeDirection(pixel, size.x);
    ivec2 extent = textureSize(panorama, 0);
    ivec2 texel = PanoramaTexel(direction, extent);
    // Vulkan uploads north-to-south rows. OpenGL flips them before upload.
    texel.y = extent.y - 1 - texel.y;
    imageStore(outputMap, pixel, texelFetch(panorama, texel, 0));
}
