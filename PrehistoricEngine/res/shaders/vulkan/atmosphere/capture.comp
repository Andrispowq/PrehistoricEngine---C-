#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 1, rgba32f) uniform writeonly image2DArray outputMap;

#define ATMOSPHERE_CAPTURE
#include "sky.glsl"
#include "../../shared/environmentMap/cubeDirection.glsl"

void main()
{
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    ivec3 extent = imageSize(outputMap);
    if (any(greaterThanEqual(pixel, extent))) return;
    imageStore(outputMap, pixel, vec4(SkyRadiance(CubeDirection(pixel, extent.x), true), 1.0));
}
