#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,rgba32f) writeonly uniform image2D target;
layout(binding=1) uniform sampler2D heightmap;
layout(push_constant) uniform Settings { int N; float strength; };
#include "../../shared/terrain/heightNormal.glsl"
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec3 normal = terrainHeightNormal(heightmap, vec2(p)/float(N), vec2(1.0/float(N)), strength);
    imageStore(target, p, vec4(normal*0.5+0.5, 1));
}
