#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Occupancy { uint cells[]; };
layout(binding = 2) uniform sampler2D terrainTextures[12];
#include "../../shared/voxel/terrain_parameters.glsl"
#include "../../shared/terrain/detail.glsl"
#include "../../shared/voxel/voxel_surface.glsl"
vec2 terrainHeightUV(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec2 terrainLayerUV(vec2 uv) { return uv * vec2(1, -1); }
#include "../../shared/voxel/terrain_material.glsl"
void storeTerrainVoxel(ivec3 cell, vec3 normal, vec3 base, float metal, vec3 emission)
{
    int size = int(terrainOptions.z);
    int index = cell.x + size * (cell.y + size * cell.z);
    atomicMax(cells[index], packUnorm4x8(vec4(base, 1)));
    if (terrainOptions.w != 0)
    {
        int count = size * size * size;
        int surfaces = (8 * count - 1) / 7;
        atomicMax(cells[surfaces + index], packBounceSurface(base * (1 - clamp(metal, 0, 1)), normal));
        vec3 encoded = encodeVoxelRadiance(emission);
        float priority = max(encoded.r, max(encoded.g, encoded.b));
        atomicMax(cells[surfaces + count + index], packUnorm4x8(vec4(encoded, (1 + 254 * priority) / 255)));
    }
}
#include "../../shared/voxel/terrain.glsl"
