#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../shared/terrain/heightNormal.glsl"
#include "../../shared/terrain/layers.glsl"

layout(local_size_x=16, local_size_y=16) in;
layout(binding=0) uniform sampler2D heightMap;
layout(binding=1, rgba8) uniform image2D normalMap;
layout(binding=2, rgba8) uniform writeonly image2D splatMap;
layout(binding=3, std430) writeonly buffer Heights { float heights[]; };
layout(push_constant) uniform Bake { int pass; float strength; };

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(normalMap);
	if (any(greaterThanEqual(p, size))) return;
	if (pass == 0)
	{
		vec2 uv = vec2(p) / vec2(size);
		uv.y = 1.0 - uv.y;
		vec3 n = terrainHeightNormal(heightMap, uv, vec2(1, -1) / vec2(size), strength);
		imageStore(normalMap, p, vec4(n * 0.5 + 0.5, 1));
		heights[p.y * size.x + p.x] = textureLod(heightMap, uv, 0).r;
	}
	else
	{
		// OpenGL samples the bilinear, repeating normal map at the texel corner p / size.
		ivec2 prev = (p + size - 1) % size;
		float up = 0.25 * (imageLoad(normalMap, p).b + imageLoad(normalMap, prev).b
			+ imageLoad(normalMap, ivec2(prev.x, p.y)).b + imageLoad(normalMap, ivec2(p.x, prev.y)).b);
		imageStore(splatMap, p, vec4(terrainLayerWeights(2.0 * up - 1.0), 0));
	}
}
